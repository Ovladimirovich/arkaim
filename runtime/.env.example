# ──────────────────────────────────────────────────────────
# Наследие Аркаима — runtime/.env
# Скопируйте этот файл в runtime/.env и заполните значения
# ──────────────────────────────────────────────────────────

# ── Публичные URL (важно для OAuth redirect_uri) ──────────
PUBLIC_BASE_URL=http://localhost:8642
FRONTEND_URL=http://localhost:3000

# ── Безопасность (ОБЯЗАТЕЛЬНО задайте в проде!) ──────────
# Приложение завершит запуск (fail-fast), если SESSION_SECRET пуст, короче
# 32 символов или является известной заглушкой. Сгенерируйте безопасный ключ:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# ── Google OAuth ──────────────────────────────────────────
# 1. Зайдите в https://console.cloud.google.com/
# 2. APIs & Services → Credentials → Create Credentials → OAuth client ID
# 3. Application type: Web application
# 4. Authorized redirect URIs:
#    http://localhost:8642/auth/google/callback
# 5. Скопируйте Client ID и Client Secret сюда:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Telegram Bot ──────────────────────────────────────────
# Получите у @BotFather: /newbot → токен
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_USERNAME=ARKAIM_AI_Bot

# ── LLM Providers (хотя бы один нужен) ────────────────────
# GigaChat (Сбер): https://developers.sber.ru/gigachat
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_TOKEN=

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Email (опционально) ───────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# ── Прочее ────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
JWT_EXPIRY_HOURS=12